--- a/python/freetoken/moe/cpu_executor.py
+++ b/python/freetoken/moe/cpu_executor.py
@@ -581,7 +581,10 @@ class CpuMoeExecutor:
             log = self._route_log.get((layer_id, bs))
             if log is None:
                 log = self._route_log[(layer_id, bs)] = alloc_pinned_tensor(bs, self.top_k, dtype=torch.int32)
-            log.copy_(io["ids"], non_blocking=True)
+            # from the *device* tensor: a host-to-host copy between pinned buffers runs on the
+            # CPU at capture time and is not part of the graph, so the log would never change
+            # on replay (it did not; the first runs reported the capture step's ids every step)
+            log.copy_(topk_ids.to(torch.int32), non_blocking=True)
             if (layer_id, bs) not in self._route_pending:
                 self._route_pending.append((layer_id, bs))
 
