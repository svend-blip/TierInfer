diff --git a/python/freetoken/moe/tierinfer_tier.py b/python/freetoken/moe/tierinfer_tier.py
new file mode 100644
index 0000000..eee05b1
--- /dev/null
+++ b/python/freetoken/moe/tierinfer_tier.py
@@ -0,0 +1,41 @@
+"""TierInfer under FreeToken: expert banks served from NVMe on first touch.
+
+Set ``TIERINFER_SOCK`` to a running ``tierinfer serve <ftw-dir> --ram-gb N``
+and pick the CPU-executor layers with ``--moe-cpu-layers``; those layers'
+banks become TierInfer-served buffers (``HostResidency.TIERED``) instead of
+being read into RAM at load. GPU layers keep FreeToken's pinned banks and the
+slot cache. The client code lives in TierInfer (``tierinfer.client``);
+``TIERINFER_SRC`` or PYTHONPATH must make it importable.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+
+def socket_path() -> str | None:
+    p = os.environ.get("TIERINFER_SOCK", "").strip()
+    return p or None
+
+
+def _client():
+    src = os.environ.get("TIERINFER_SRC")
+    if src and src not in sys.path:
+        sys.path.insert(0, src)
+    try:
+        from tierinfer import client
+    except ImportError as exc:  # pragma: no cover - environment
+        raise RuntimeError(
+            "TIERINFER_SOCK is set but tierinfer.client cannot be imported; "
+            "set TIERINFER_SRC=<TierInfer>/src or put it on PYTHONPATH"
+        ) from exc
+    return client
+
+
+def tiered_region(sock: str, *, tag: str, nbytes: int, logical_off: int):
+    return _client().TieredRegion(sock, tag=tag, nbytes=nbytes, logical_off=logical_off)
+
+
+def route(sock: str, layer: int, ids, *, after: bool = True) -> None:
+    _client().session(sock).route(layer, ids, after=after)
-- 
2.43.0


From 4e7b8856ea5fe5c9926b9deecc4098b42b5b94de Mon Sep 17 00:00:00 2001
From: svend-blip <svend@torplarsen.dk>
Date: Fri, 18 Sep 2026 10:49:20 +0200
Subject: [PATCH 2/3] fix(moe): drain the stream before reporting the previous
 step's routing to TierInfer

The per-layer id logs are written by the graph on the compute stream; read
before it drains they describe the step before the one whose faults are
being scored.
---
 python/freetoken/moe/cpu_executor.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/python/freetoken/moe/cpu_executor.py b/python/freetoken/moe/cpu_executor.py
index ca81e32..c21df82 100644
--- a/python/freetoken/moe/cpu_executor.py
+++ b/python/freetoken/moe/cpu_executor.py
@@ -607,6 +607,10 @@ class CpuMoeExecutor:
             return
         from freetoken.moe.tierinfer_tier import route
 
+        # the log copies ride the compute stream inside the previous step's graph; the
+        # step's CPU work (and its faults) finished when that stream drained, and so did
+        # the ids — read them only then, or the report describes the step before
+        torch.cuda.current_stream().synchronize()
         for layer_id, bs in self._route_pending:
             route(self._tier_sock, layer_id, self._route_log[(layer_id, bs)], after=True)
 
-- 
